# /etc/shop/app.env on the application VM (chmod 600). Read by both services (shop-backend, shop-payment).
SPRING_PROFILES_ACTIVE=prod
APP_RELEASE_STAGE=demo

DB_HOST=10.0.0.13
DB_PORT=5432
DB_NAME=shop
DB_USER=shop
DB_PASSWORD=change-me-shop-db-password
DB_POOL_SIZE=20

PAYMENT_DB_NAME=payments
PAYMENT_DB_USER=payments
PAYMENT_DB_PASSWORD=change-me-payment-db-password

# Shared secret between the backend and the payment service: openssl rand -hex 24
PAYMENT_API_KEY=change-me-payment-api-key
PAYMENT_URL=http://127.0.0.1:8090

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Admin account created on first start (only if it does not exist yet).
APP_ADMIN_EMAIL=admin@saibuoc.vn
APP_ADMIN_PASSWORD=change-me-admin-password

# Private IP of the web VM: only it may call port 8080; also the trusted proxy for X-Forwarded-*.
FRONTEND_HOST=10.0.0.11
APP_TRUSTED_PROXY='10\.0\.0\.11'
# Network allowed to reach the management port 8081 (health, metrics).
ADMIN_SUBNET=10.0.0.0/24

# Sample data (products, customers, 90 days of orders) and the fault-injection page: test environments only.
APP_SEED_ENABLED=false
APP_SIMULATION_ENABLED=false

BACKEND_JAVA_OPTS="-Xms512m -Xmx2g -Duser.timezone=UTC"
PAYMENT_JAVA_OPTS="-Xms128m -Xmx384m -Duser.timezone=UTC"
