# /etc/shop/web.env on the web VM. Copy from this file and fill in.
# Domain or IP users open in the browser.
APP_DOMAIN=shop.example.com
# Private IP:port of the application VM
BACKEND_UPSTREAM=10.0.0.12:8080
# Readiness endpoint polled by shop-upstream-check (default: http://<backend host>:8081/actuator/health/readiness)
#BACKEND_HEALTH_URL=http://10.0.0.12:8081/actuator/health/readiness
