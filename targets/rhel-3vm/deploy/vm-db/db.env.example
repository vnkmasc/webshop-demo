# /etc/shop/db.env on the database VM (chmod 600). Copy from this file and fill in.
# Private IP of the application VM: the only host allowed to reach PostgreSQL (5432).
BACKEND_HOST=10.0.0.12
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=change-me-shop-db-password
PAYMENT_DB_NAME=payments
PAYMENT_DB_USER=payments
PAYMENT_DB_PASSWORD=change-me-payment-db-password
BACKUP_DIR=/var/lib/pgsql/backups/shop
BACKUP_KEEP=7
# Orders placed by the load generator (note "k6") older than this many days are deleted nightly at 03:00.
# Leave empty to keep everything (no clean-up job).
LOAD_CLEANUP_DAYS=2
