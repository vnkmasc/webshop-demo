# Continuous background load as a systemd *user* service (no root needed). This is what runs on the
# control machine of the RHEL 3-VM target:
#   mkdir -p ~/.config/systemd/user ~/.config/shop-load
#   cp load/shop-load.user.service ~/.config/systemd/user/shop-load.service
#   cp load/shop-load.env.example ~/.config/shop-load/env && chmod 600 ~/.config/shop-load/env   # then edit it
#   loginctl enable-linger "$USER"          # keep running without a login session
#   systemctl --user daemon-reload && systemctl --user enable --now shop-load
# Adjust the k6 and script paths below if the repo is not at ~/promptdo/webshop-demo.
[Unit]
Description=Shop background load (k6)
After=network-online.target

[Service]
EnvironmentFile=%h/.config/shop-load/env
ExecStart=%h/.local/bin/k6 run --quiet %h/promptdo/webshop-demo/load/shop.js
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
