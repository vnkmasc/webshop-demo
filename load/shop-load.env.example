# ~/.config/shop-load/env (chmod 600) - read by shop-load.user.service
BASE_URL=http://shop.example.com
PROFILE=steady
DURATION=8760h
ADMIN_PASSWORD=change-me
# Continuous background traffic, kept light: ~80 requests/min and ~20-30 orders/hour.
VUS=4
BUY_PERCENT=3
# For a demo session with heavy traffic: VUS=10 and BUY_PERCENT=25 (~440 orders/hour).
