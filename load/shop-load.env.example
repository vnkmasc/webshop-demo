# ~/.config/shop-load/env (chmod 600) - read by shop-load.user.service
BASE_URL=http://shop.example.com
PROFILE=steady
DURATION=8760h
ADMIN_PASSWORD=change-me
# Continuous background traffic, kept light: ~60 requests/min and ~70 orders/hour.
VUS=2
BUY_PERCENT=2
# Orders placed per minute at a fixed rate, on top of the browsing users (0 = off).
ORDERS_PER_MIN=1
# For a demo session with heavy traffic: VUS=10, BUY_PERCENT=25, ORDERS_PER_MIN=10 (~1000 orders/hour).
