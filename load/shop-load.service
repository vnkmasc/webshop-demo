# Continuous background traffic (install on a separate machine, not on the three shop VMs):
#   sudo cp -r load /opt/shop-load && sudo cp load/shop-load.service /etc/systemd/system/
#   sudo systemctl edit shop-load   # set BASE_URL, VUS, ADMIN_PASSWORD
#   sudo systemctl enable --now shop-load
[Unit]
Description=Shop background load (k6)
After=network-online.target
Wants=network-online.target

[Service]
Environment=BASE_URL=http://shop.example.com
Environment=PROFILE=steady
Environment=VUS=8
Environment=DURATION=24h
Environment=ADMIN_PASSWORD=change-me
ExecStart=/usr/bin/k6 run --quiet /opt/shop-load/shop.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
